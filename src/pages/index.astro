---
import Base from '../layouts/Base.astro';

const products = [
  {
    name: 'BundaGizi',
    status: 'Live',
    relation: 'Operated by Nalar Cipta',
    description: 'Personal assistant for mothers: child nutrition, growth tracking, and daily guidance on WhatsApp.',
    audience: 'Parents of children 0-5',
    action: 'Visit product',
    href: 'https://www.bundagizi.com',
  },
  {
    name: 'AsistenDiet',
    status: 'In development',
    relation: 'Product by Nalar Cipta',
    description: 'Personal diet assistant on WhatsApp for cut, bulk, or maintain goals with food logging in chat.',
    audience: 'Adults with a body goal',
    action: 'Coming soon',
    href: null,
  },
];

const capabilities = [
  ['Build focused products', 'We turn specific everyday needs into software with a clear purpose and audience.'],
  ['Operate what we build', 'We improve products through real usage, practical feedback, and continuous iteration.'],
  ['Design for familiar channels', 'We use interfaces people already understand, including WhatsApp, when that makes a product easier to use.'],
  ['Work within clear boundaries', 'We define each product’s scope carefully, especially in health-related contexts.'],
];

const legalRows = [
  ['Registered name', 'NALAR CIPTA TEKNOLOGI'],
  ['Public name', 'PT Nalar Cipta Teknologi'],
  ['Registration', 'AHU-A112793.AH.01.30.Tahun 2026'],
  ['Established', '2026, Indonesia'],
];
---

<Base>
  <header class="site-header" aria-label="Main navigation">
    <a class="brand" href="#top" aria-label="Nalar Cipta home">
      <img class="brand-mark" src="/brand/logos/mark-full-color.svg" alt="" width="40" height="40" />
      <span>Nalar Cipta</span>
    </a>
    <nav class="nav-links" aria-label="Page sections">
      <a href="#what-we-do">What we do</a>
      <a href="#products">Products</a>
      <a href="#company">Company</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero section-wrap">
      <div class="hero-copy" data-hero-copy>
        <p class="kicker">PT Nalar Cipta Teknologi</p>
        <h1>We build focused digital products for everyday needs.</h1>
        <p class="hero-lede">
          Nalar Cipta is a registered Indonesian technology company building practical, domain-focused software.
        </p>
        <p class="brand-tagline">Thoughtful technology, built for real life.</p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button primary" href="#products">View products</a>
          <a class="button secondary" href="#company">Company details</a>
        </div>
      </div>

      <aside class="identity-card" aria-label="Company identity card" data-hero-card>
        <div class="identity-orbit orbit-one" aria-hidden="true"></div>
        <div class="identity-orbit orbit-two" aria-hidden="true"></div>
        <div class="identity-topline">
          <span>Nalar Cipta</span>
          <span>Technology Company</span>
        </div>
        {/* Orbit center is supporting graphic only — not a second logo variant. */}
        <div class="identity-focus" aria-hidden="true">
          <span class="identity-focus-ring"></span>
          <span class="identity-focus-core"></span>
          <span class="identity-focus-node"></span>
        </div>
        <div class="identity-list">
          <div>
            <span>Registered</span>
            <strong>AHU-A112793.AH.01.30.Tahun 2026</strong>
          </div>
          <div>
            <span>Products</span>
            <strong>BundaGizi live / AsistenDiet in development</strong>
          </div>
        </div>
      </aside>
    </section>

    <section class="entity section-wrap" aria-label="Entity snapshot">
      <p>Registered Indonesian company</p>
      <strong>NALAR CIPTA TEKNOLOGI</strong>
      <span>AHU-A112793.AH.01.30.Tahun 2026 / Est. 2026</span>
    </section>

    <section class="section-wrap approach" id="what-we-do">
      <div class="section-heading">
        <h2>What we do</h2>
        <p>We build and operate focused software products from idea to everyday use.</p>
      </div>
      <div class="principle-grid motion-group" data-motion-group>
        {capabilities.map(([title, body], index) => (
          <article class={`capability capability-${index + 1} motion-item`} style={`--motion-index: ${index}`}>
            <span class="capability-index" aria-hidden="true">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-wrap products" id="products">
      <div class="section-heading compact">
        <h2>Products we build and operate</h2>
        <p>Each product has an independent identity, a clear audience, and a focused scope.</p>
      </div>

      <div class="product-grid motion-group" data-motion-group>
        {products.map((product, index) => (
          <article class={`product-card motion-item ${product.status === 'Live' ? 'is-live' : 'is-development'}`} style={`--motion-index: ${index}`}>
            <div class="card-head">
              <div>
                <h3>{product.name}</h3>
                <p>{product.relation}</p>
              </div>
              <span class="status-pill">{product.status}</span>
            </div>
            <p class="product-desc">{product.description}</p>
            <dl class="product-meta">
              <div>
                <dt>Audience</dt>
                <dd>{product.audience}</dd>
              </div>
            </dl>
            {product.href ? (
              <a class="text-link" href={product.href} target="_blank" rel="noreferrer">{product.action}</a>
            ) : (
              <span class="text-link muted">{product.action}</span>
            )}
          </article>
        ))}
      </div>
      <p class="section-note">Other experiments stay internal until they are ready for public use.</p>
    </section>

    <section class="about section-wrap" id="about">
      <div class="about-title">
        <h2>About Nalar Cipta</h2>
      </div>
      <div class="about-body">
        <p>Nalar Cipta turns specific everyday needs into focused, practical software.</p>
        <p>We build and operate one product at a time, prioritizing clarity, usefulness, and responsible scope.</p>
        <div class="chip-row" aria-label="Product principles">
          <span>Focused</span>
          <span>Practical</span>
          <span>Responsible</span>
        </div>
      </div>
    </section>

    <section class="company section-wrap" id="company">
      <div class="section-heading compact">
        <h2>Company information</h2>
        <p>Basic registration details for public verification.</p>
      </div>
      <div class="legal-panel">
        <dl>
          {legalRows.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <p class="legal-note">Registered company in Indonesia.</p>
        <p class="legal-note muted">Additional documents are provided privately when required for formal verification.</p>
      </div>
    </section>

    <section class="contact section-wrap" id="contact">
      <div>
        <h2>Contact</h2>
        <p>For partnership, verification, or general inquiries:</p>
      </div>
      <a class="contact-card" href="mailto:contact@nalarcipta.web.id">
        <span>Email</span>
        <strong>contact@nalarcipta.web.id</strong>
      </a>
      <div class="contact-meta">
        <span>Surakarta, Indonesia</span>
        <a href="https://www.bundagizi.com" target="_blank" rel="noreferrer">BundaGizi support</a>
      </div>
    </section>
  </main>

  <footer class="footer section-wrap">
    <div class="footer-brand">
      <img src="/brand/logos/mark-full-color.svg" alt="" width="32" height="32" />
      <p>© 2026 PT Nalar Cipta Teknologi</p>
    </div>
    <nav aria-label="Footer links">
      <a href="#products">Products</a>
      <a href="#company">Company</a>
      <a href="#contact">Contact</a>
      <a href="https://www.bundagizi.com" target="_blank" rel="noreferrer">BundaGizi</a>
    </nav>
    <span>nalarcipta.web.id</span>
  </footer>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        root.classList.add('motion-static');
        return;
      }

      root.classList.add('motion-ready');
      requestAnimationFrame(() => root.classList.add('hero-visible'));

      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.16, rootMargin: '0px 0px -48px' });

      document.querySelectorAll('[data-motion-group]').forEach((group) => observer.observe(group));
    })();
  </script>
</Base>
