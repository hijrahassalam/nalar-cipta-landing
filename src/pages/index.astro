---
import Base from '../layouts/Base.astro';

const products = [
  {
    name: 'BundaGizi',
    status: 'Live',
    relation: 'Operated by Nalar Cipta',
    description: 'Personal assistant for mothers: child nutrition, growth tracking, and daily guidance on WhatsApp.',
    audience: 'Parents of children 0-5',
    action: 'Visit product',
    href: 'https://www.bundagizi.com',
  },
  {
    name: 'AsistenDiet',
    status: 'In development',
    relation: 'Product by Nalar Cipta',
    description: 'Personal diet assistant on WhatsApp for cut, bulk, or maintain goals with food logging in chat.',
    audience: 'Adults with a body goal',
    action: 'Coming soon',
    href: null,
  },
];

const principles = [
  ['Focused use cases', 'Each product is built around one clear job, not a long list of loosely related features.'],
  ['Everyday channels', 'We prefer interfaces people already use, like WhatsApp, when that reduces friction.'],
  ['Domain-specific assistance', 'We build products with context, memory, and domain boundaries instead of generic chat wrappers.'],
  ['Responsible scope', 'Health-related tools must be helpful, clear, and honest about what they can and cannot replace.'],
];

const legalRows = [
  ['Legal name', 'NALAR CIPTA TEKNOLOGI'],
  ['Public name', 'Nalar Cipta / PT Nalar Cipta Teknologi'],
  ['Legal form', 'Perseroan Perorangan - Indonesian sole-shareholder limited liability company'],
  ['Business scale', 'Micro Enterprise'],
  ['Registration', 'AHU-A112793.AH.01.30.Tahun 2026'],
  ['Established', '12 August 2026'],
  ['Domicile', 'Surakarta, Indonesia'],
  ['Founder', 'Nur Hijrah As Salam Al Ihsan'],
  ['Products', 'BundaGizi (live), AsistenDiet (in development)'],
  ['Website', 'https://nalarcipta.web.id'],
];
---

<Base>
  <header class="site-header" aria-label="Main navigation">
    <a class="brand" href="#top" aria-label="Nalar Cipta home">
      <span class="brand-mark">NC</span>
      <span>Nalar Cipta</span>
    </a>
    <nav class="nav-links" aria-label="Page sections">
      <a href="#products">Products</a>
      <a href="#about">About</a>
      <a href="#approach">Approach</a>
      <a href="#company">Company</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero section-wrap">
      <div class="hero-copy">
        <p class="kicker">PT Nalar Cipta Teknologi</p>
        <h1>Building and operating focused digital products.</h1>
        <p class="hero-lede">
          Nalar Cipta is a registered technology company based in Surakarta, Indonesia. We build practical products for daily life, starting with BundaGizi.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button primary" href="#products">View products</a>
          <a class="button secondary" href="#company">Company details</a>
        </div>
      </div>

      <aside class="identity-card" aria-label="Company identity card">
        <div class="identity-topline">
          <span>Nalar Cipta</span>
          <span>Product Studio</span>
        </div>
        <div class="identity-mark">NC</div>
        <div class="identity-list">
          <div>
            <span>Registered</span>
            <strong>AHU-A112793.AH.01.30.Tahun 2026</strong>
          </div>
          <div>
            <span>Products</span>
            <strong>BundaGizi live / AsistenDiet in development</strong>
          </div>
        </div>
      </aside>
    </section>

    <section class="entity section-wrap" aria-label="Entity snapshot">
      <p>Registered Indonesian company</p>
      <strong>NALAR CIPTA TEKNOLOGI</strong>
      <span>AHU-A112793.AH.01.30.Tahun 2026 / Surakarta / Est. 2026</span>
    </section>

    <section class="section-wrap products" id="products">
      <div class="section-heading compact">
        <h2>Products under Nalar Cipta</h2>
        <p>Products under Nalar Cipta are built as independent brands, each with a clear audience and scope.</p>
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <article class={`product-card ${product.status === 'Live' ? 'is-live' : ''}`}>
            <div class="card-head">
              <div>
                <h3>{product.name}</h3>
                <p>{product.relation}</p>
              </div>
              <span class="status-pill">{product.status}</span>
            </div>
            <p class="product-desc">{product.description}</p>
            <dl class="product-meta">
              <div>
                <dt>Audience</dt>
                <dd>{product.audience}</dd>
              </div>
            </dl>
            {product.href ? (
              <a class="text-link" href={product.href} target="_blank" rel="noreferrer">{product.action}</a>
            ) : (
              <span class="text-link muted">{product.action}</span>
            )}
          </article>
        ))}
      </div>
      <p class="section-note">Other experiments stay internal until they are ready for public use.</p>
    </section>

    <section class="about section-wrap" id="about">
      <div class="about-title">
        <h2>A focused product studio from Surakarta.</h2>
      </div>
      <div class="about-body">
        <p>Nalar Cipta turns specific daily problems into simple, reliable software.</p>
        <p>We build deliberately: one focused product at a time, with real usage as the measure of progress.</p>
        <p>Our work today centers on health and daily routines, areas where clarity, trust, and consistency matter more than hype.</p>
        <div class="chip-row" aria-label="Product principles">
          <span>Focused</span>
          <span>Practical</span>
          <span>Responsible</span>
        </div>
      </div>
    </section>

    <section class="section-wrap approach" id="approach">
      <div class="section-heading">
        <h2>What guides our products</h2>
        <p>Our craft is product work, not slide decks.</p>
      </div>
      <div class="principle-grid">
        {principles.map(([title, body]) => (
          <article>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="company section-wrap" id="company">
      <div class="section-heading compact">
        <h2>Legal identity</h2>
        <p>Official company details for verification, partnership, and compliance.</p>
      </div>
      <div class="legal-panel">
        <dl>
          {legalRows.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <p class="legal-note">Terdaftar sebagai Perseroan Perorangan di Indonesia.</p>
        <p class="legal-note muted">This page is the public corporate presence of PT Nalar Cipta Teknologi.</p>
      </div>
    </section>

    <section class="contact section-wrap" id="contact">
      <div>
        <h2>Contact</h2>
        <p>For partnership, verification, or general inquiries:</p>
      </div>
      <a class="contact-card" href="mailto:contact@nalarcipta.web.id">
        <span>Email</span>
        <strong>contact@nalarcipta.web.id</strong>
      </a>
      <div class="contact-meta">
        <span>Surakarta, Indonesia</span>
        <a href="https://www.bundagizi.com" target="_blank" rel="noreferrer">BundaGizi support</a>
      </div>
    </section>
  </main>

  <footer class="footer section-wrap">
    <p>© 2026 PT Nalar Cipta Teknologi</p>
    <nav aria-label="Footer links">
      <a href="#products">Products</a>
      <a href="#company">Company</a>
      <a href="#contact">Contact</a>
      <a href="https://www.bundagizi.com" target="_blank" rel="noreferrer">BundaGizi</a>
    </nav>
    <span>nalarcipta.web.id</span>
  </footer>
</Base>
